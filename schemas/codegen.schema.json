{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Generation Task Schema",
  "description": "Schema for code generation task records",
  "allOf": [
    {
      "$ref": "common.schema.json"
    }
  ],
  "properties": {
    "task": {
      "const": "codegen"
    },
    "metadata": {
      "properties": {
        "function_name": {
          "type": "string",
          "description": "Name of the function"
        },
        "num_lines": {
          "type": "integer",
          "description": "Number of lines in function",
          "minimum": 1
        },
        "has_docstring": {
          "type": "boolean",
          "description": "Whether function has a docstring"
        }
      }
    }
  }
}
